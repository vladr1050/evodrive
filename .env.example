APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development: sqlite. Production (Docker): use pgsql.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=postgres
# DB_PORT=5432
# DB_DATABASE=evodrive
# DB_USERNAME=evodrive
# DB_PASSWORD=

# sqlite (local)
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Production: use redis for session, cache, queue
# SESSION_DRIVER=redis
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Analytics 4 (optional; default set in config)
# GOOGLE_ANALYTICS_ID=G-NTWCKVPZ63

# Telegram: shift cancellation notifications to a group
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_SHIFTS_CHAT_ID=
# TELEGRAM_CANCELLATION_NOTIFY_MAX_PER_DRIVER=3
# TELEGRAM_CANCELLATION_RATE_WINDOW_MINUTES=30
# TELEGRAM_REPLACEMENT_TOLERANCE_MINUTES=15

# NESS SMS (car control: open/close doors, lock/unlock engine)
# NESS_SMS_API_KEY=
# NESS_SMS_SENDER_ID=Evodrive
# NESS_SMS_BASE_URL=https://traffic.sales.lv/API:0.16/

# Car control (optional overrides; defaults in config/car_control.php)
# CAR_CONTROL_WINDOW_MINUTES=45
# CAR_CONTROL_RATE_LIMIT_DRIVER_SECONDS=15
# CAR_CONTROL_RATE_LIMIT_VEHICLE_SECONDS=10
# CAR_CONTROL_PAIR_SMS_DELAY_SECONDS=3
